{
  "schema_version": 1,
  "base_ref": "origin/develop",
  "base_branch": "develop",
  "branch": "codex/continuous-development",
  "active_environment": "local",
  "pull_request": 55,
  "checkpoint": "automation/cloud-checkpoint.json",
  "workspace_relative": ".tmp/continuous-development",
  "runtime_relative": ".tmp/development-loop",
  "lease_minutes": 120,
  "cycle_minutes": 45,
  "retry_limit": 3,
  "allow_push": true,
  "allow_draft_pr": true,
  "allow_merge": false,
  "allow_deploy": false,
  "protected_branches": ["develop", "main", "preview", "test"],
  "profiles": {
    "control": [["python", "-m", "pytest", "tests/test_development_loop.py", "-q"]],
    "registry": [
      ["python", "scripts/aidlc_vendor.py", "verify"],
      ["python", "scripts/card-db-manifest.py", "verify"],
      ["python", "-m", "tools.ai_sandbox.effect_registry_integrity", "--database", "data/loveca.sqlite3", "--strict", "--output", "{run_dir}/registry"]
    ],
    "backend": [["python", "-m", "pytest", "-q", "--basetemp", "{run_dir}/pytest"]],
    "web": [["npm", "--prefix", "web", "run", "test", "--", "--run"], ["npm", "--prefix", "web", "run", "build"]]
  }
}
